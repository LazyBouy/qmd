# =============================================================================
# QMD Docker Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Root directory for all persistent agent state on the HOST machine.
# Each agent component stores its state under a subdirectory:
#   qmd   → ${AGENT_STATE_BASE}/qmd   (index.sqlite, models, collection YAML)
#   other → ${AGENT_STATE_BASE}/openfang, ${AGENT_STATE_BASE}/paperclip, etc.
#
# Must be an absolute path — Docker Compose does NOT expand ~.
# Example: /home/alice/agent-phi/state
# -----------------------------------------------------------------------------
AGENT_STATE_BASE=/home/user/agent-phi/state

# -----------------------------------------------------------------------------
# Docker network shared by all agent containers (qmd, paperclip, openfang, …).
# Containers on this network can reach each other by service name.
# Example: http://qmd:8181/mcp is reachable from any peer container.
# -----------------------------------------------------------------------------
AGENT_NETWORK=agent-phi

# -----------------------------------------------------------------------------
# QMD MCP HTTP server port exposed on the HOST.
# The container always listens internally on 8181; this maps it to the host.
# Set to an empty string to skip host-port exposure (internal-only access).
# -----------------------------------------------------------------------------
QMD_PORT=8181
