# =============================================================================
# QMD Docker Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Base installation folder for the entire agent stack on this host.
# QMD state lives at ${AGENT_BASE}/state/qmd and is mounted as /data inside
# the container.  Other services share the same base:
#   openfang  → ${AGENT_BASE}/state/openfang
#   paperclip → ${AGENT_BASE}/state/paperclip
#
# Must be an absolute path — Docker Compose does NOT expand ~.
# Example: /home/alice/agent-phi
# -----------------------------------------------------------------------------
AGENT_BASE=/home/user/agent-phi

# -----------------------------------------------------------------------------
# Name of the shared Docker network all agent containers join.
# Convention: last path segment of AGENT_BASE.
# Example: AGENT_BASE=/home/user/agent-phi  →  AGENT_NETWORK=agent-phi
# Create once:  docker network create ${AGENT_NETWORK}
# -----------------------------------------------------------------------------
AGENT_NETWORK=agent-phi

# -----------------------------------------------------------------------------
# QMD MCP HTTP server port exposed on the HOST.
# The container always listens internally on 8181; this maps it to the host.
# Set to an empty string to skip host-port exposure (internal-only access).
# -----------------------------------------------------------------------------
QMD_PORT=8181
