# =============================================================================
# QMD Docker Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared agent state directory on the HOST machine.
# Each agent component stores its persistent data under a subdirectory here.
#   qmd state  → ${AGENT_STATE_DIR}/qmd   (index.sqlite + downloaded models)
#   other agents (e.g. openfang) → ${AGENT_STATE_DIR}/openfang
# -----------------------------------------------------------------------------
AGENT_STATE_DIR=~/agent-phi/state

# -----------------------------------------------------------------------------
# Shared agent config directory on the HOST machine.
# Each agent component stores its config files under a subdirectory here.
#   qmd config → ${AGENT_CONFIG_DIR}/qmd  (collection YAML definitions)
# -----------------------------------------------------------------------------
AGENT_CONFIG_DIR=~/agent-phi/config

# -----------------------------------------------------------------------------
# Docker network shared by all agent containers (qmd, paperclip, openfang, …).
# Containers on this network can reach each other by service name.
# Example: http://qmd:8181/mcp is reachable from any peer container.
# -----------------------------------------------------------------------------
AGENT_NETWORK=agent-phi

# -----------------------------------------------------------------------------
# QMD MCP HTTP server port exposed on the HOST.
# The container always listens internally on 8181; this maps it to the host.
# Set to an empty string to skip host-port exposure (internal-only access).
# -----------------------------------------------------------------------------
QMD_PORT=8181
